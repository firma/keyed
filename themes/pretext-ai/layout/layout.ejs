<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>" data-theme="dark">
<head>
  <%- partial('_partial/head') %>
</head>
<body>
  <div id="pretext-bg" class="pretext-bg"></div>
  <%- partial('_partial/header') %>
  <main class="main-container">
    <div class="content-wrapper">
      <div class="content-area">
        <%- body %>
      </div>
      <% if (theme.sidebar) { %>
      <aside class="sidebar">
        <%- partial('_partial/sidebar') %>
      </aside>
      <% } %>
    </div>
  </main>
  <%- partial('_partial/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/@aspect-build/pretext@latest/dist/pretext.min.js"></script>
  <script src="<%- url_for('/js/main.js') %>"></script>
</body>
</html>
