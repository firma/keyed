<main class="main-container">
  <div class="content-wrapper">
    <div class="content-area">
      <div class="archive-page">
        <h1 class="page-title">Archives</h1>
        <%
        var yearGroups = {};
        page.posts.forEach(function(post) {
          var year = date(post.date, 'YYYY');
          if (!yearGroups[year]) yearGroups[year] = [];
          yearGroups[year].push(post);
        });
        var years = Object.keys(yearGroups).sort(function(a,b){ return b - a; });
        %>
        <% years.forEach(function(year) { %>
        <section class="archive-year-group">
          <h2 class="archive-year"><%= year %></h2>
          <ul class="archive-list">
            <% yearGroups[year].forEach(function(post) { %>
            <li class="archive-item">
              <time class="archive-date"><%= date(post.date, 'MM-DD') %></time>
              <a href="<%- url_for(post.path) %>" class="archive-link"><%= post.title || '(Untitled)' %></a>
              <% if (post.categories && post.categories.length) { %>
                <% post.categories.forEach(function(cat) { %>
                  <span class="archive-cat"><%= cat.name %></span>
                <% }) %>
              <% } %>
            </li>
            <% }) %>
          </ul>
        </section>
        <% }) %>
        <%- partial('_partial/pagination') %>
      </div>
    </div>
    <% if (theme.sidebar) { %>
    <aside class="sidebar">
      <%- partial('_partial/sidebar') %>
    </aside>
    <% } %>
  </div>
</main>
