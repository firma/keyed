<% if (page.total > 1) { %>
<nav class="pagination">
  <% if (page.prev) { %>
    <a href="<%- url_for(page.prev_link) %>" class="page-btn prev">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Prev
    </a>
  <% } else { %>
    <span class="page-btn prev disabled">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Prev
    </span>
  <% } %>
  <span class="page-info"><%= page.current %> / <%= page.total %></span>
  <% if (page.next) { %>
    <a href="<%- url_for(page.next_link) %>" class="page-btn next">
      Next
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  <% } else { %>
    <span class="page-btn next disabled">
      Next
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  <% } %>
</nav>
<% } %>
